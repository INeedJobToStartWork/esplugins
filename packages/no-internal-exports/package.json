{
	"name": "@packages/no-internal-exports",
	"version": "1.1.0",
	"description": "Esbuild, Vite, Rollup, Rolldown, webpack and Rspack plugin for not exporting @internal functions/types/variables from entry files",
	"keywords": [
		"no-internal-exports",
		"esplugins",
		"esbuild",
		"plugin",
		"esbuild-plugin",
		"esbuild-plugin-no-internal-exports",
		"internal",
		"tsup",
		"vite-plugin",
		"rollup-plugin",
		"rolldown-plugin",
		"tsdown",
		"webpack-plugin",
		"rspack-plugin",
		"unplugin"
	],
	"homepage": "https://github.com/INeedJobToStartWork/esplugins",
	"bugs": "https://github.com/INeedJobToStartWork/esplugins/issues/new/choose",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/INeedJobToStartWork/esplugins.git",
		"directory": "packages/no-internal-exports"
	},
	"license": "MIT",
	"author": "ineedjobtostartwork",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"------------------------INSTALLATION-------------------": "",
		"prepare": "",
		"pre": "git add . && npx lint-staged",
		"------------------------UTILS--------------------------": "",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "pnpm prettier . --write && pnpm prettier . --check",
		"format:check": "pnpm prettier . --check",
		"------------------------BUILDS-------------------------": "",
		"build:dev": "pnpm cross-env NODE_ENV=development pnpm tsdown --config-loader unrun --config ./config/tsdownrc/tsdown.dev.ts",
		"build:prod": "pnpm cross-env NODE_ENV=production pnpm tsdown --config-loader unrun --config ./config/tsdownrc/tsdown.prod.ts",
		"build:npm": "pnpm cross-env NODE_ENV=production pnpm npm:prepack && pnpm tsdown --config-loader unrun --config ./config/tsdownrc/tsdown.npm.ts && pnpm npm:postpack",
		"------------------------DEPLOYS------------------------": "",
		"npm:prepack": "clean-package",
		"npm:postpack": "clean-package restore",
		"------------------------TESTS--------------------------": "",
		"test": "pnpm cross-env NODE_ENV=test pnpm vitest test",
		"test:watch": "pnpm cross-env NODE_ENV=test pnpm vitest test --watch",
		"test:coverage": "pnpm cross-env NODE_ENV=test pnpm vitest test --coverage",
		"test:integration": "pnpm build:npm && pnpm cross-env NODE_ENV=test pnpm vitest run --config ./vitest.integration.config.ts",
		"------------------------NPM----------------------------": "",
		"prepublishOnly": "pnpm build:npm"
	},
	"dependencies": {
		"magic-string": "^1.4.5",
		"oxc-parser": "^0.159.0",
		"unplugin": "^3.7.0"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@configs/vitest": "workspace:*",
		"@ineedj/eslintrc": "1.2.3",
		"@ineedj/prettierrc": "3.0.0",
		"@ineedj/tsconfig": "^1.0.0",
		"@rspack/core": "^2.3.3",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "^5.0.5",
		"clean-package": "^2.2.0",
		"cross-env": "^10.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^8.57.1",
		"prettier": "^3.8.3",
		"publint": "^0.3.19",
		"rolldown": "^1.3.2",
		"rollup": "^4.68.5",
		"tsdown": "^0.23.1",
		"typescript": "^7.0.2",
		"unrun": "^0.3.1",
		"vite": "^8.3.8",
		"vitest": "^5.0.5",
		"webpack": "^5.112.2"
	},
	"peerDependencies": {
		"esbuild": ">=0.18.0"
	},
	"peerDependenciesMeta": {
		"esbuild": {
			"optional": true
		}
	},
	"publishConfig": {
		"access": "public",
		"directory": "dist",
		"provenance": true,
		"tag": "latest"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
